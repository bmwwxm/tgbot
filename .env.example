# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# ── TON Wallet ────────────────────────────────────────────
# 24-word mnemonic of the hot wallet (space-separated)
WALLET_MNEMONICS=word1 word2 word3 ... word24

# TON Center API key (https://toncenter.com/ — free tier available)
TONCENTER_API_KEY=

# Network: mainnet or testnet
TON_NETWORK=mainnet

# ── Investment Settings ───────────────────────────────────
# Minimum deposit amount in TON
MIN_DEPOSIT=10

# Profit percentage after maturity
PROFIT_PERCENT=10

# Deposit maturity time in seconds (36000 = 10 hours)
DEPOSIT_MATURITY_SECONDS=36000

# Referral bonus percentage (from referral's deposit profit)
REFERRAL_PERCENT=10

# Minimum withdrawal in TON
MIN_WITHDRAWAL=1

# Withdrawal fee in TON
WITHDRAWAL_FEE=0.01

# ── Feed Channel Bot ──────────────────────────────────────
# Second bot that posts real-time payouts to a public channel
# Create a separate bot via @BotFather and add it as admin to your channel
FEED_BOT_TOKEN=
# Channel ID (e.g. -1001234567890) or @channel_username
FEED_CHANNEL_ID=
# Feed language: ru or en
FEED_LANG=ru

# ── Admin ─────────────────────────────────────────────────
# Comma-separated Telegram user IDs
ADMIN_IDS=

# ── Server ────────────────────────────────────────────────
# Public URL where the Mini App is hosted (for Telegram WebApp)
WEBAPP_URL=https://your-domain.com

# Database file path
DB_PATH=data/bot.db

# Server host/port
HOST=0.0.0.0
PORT=8000
